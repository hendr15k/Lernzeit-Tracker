# Kopieren nach .env und Werte eintragen. .env wird nie committet.
# AUTH_SECRET: mindestens 32 zufällige Zeichen, z.B. `openssl rand -base64 48`.
AUTH_USER=hendrik
AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
# Passwort-Hash erzeugen mit: PASSWORD='dein-passwort' node server/hash-password.js
AUTH_PASSWORD_HASH='CHANGE_ME'
APP_PORT=8085
